# Private server file: /home/workspace/subapi/.env, chmod 600.
# Fill all passwords and keys before enabling MYSUBAPI_DEPLOY_ENABLED in GitHub.
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai
RUN_MODE=standard
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate each secret independently with: openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# Required only with MYSUBAPI_OPENCODE_FREE_ENABLED=true; at least 32 ASCII chars.
OPENCODE_FREE_BUN_TOKEN=
# Shared-account charging requires a separately approved rollout.
MARKETPLACE_ENABLED=false
MARKETPLACE_ONBOARDING_ENABLED=false
MARKETPLACE_DISPATCH_ENABLED=false
MARKETPLACE_PAYOUTS_ENABLED=false
